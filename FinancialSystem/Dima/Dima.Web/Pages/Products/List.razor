@page "/premium"
@inherits ListProductsPage

<MudContainer Class="mt-16">
    <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true">Premium</MudText>
    <MudText Align="Align.Center" GutterBottom="true">Tenha acesso imlimitado a aplicação incluindo trasações e categorias ilimitadas</MudText>
    <MudGrid Class="mt-8 justify-content-center">
        @foreach(var product in Products)
        {
            <MudItem xs=12" sm="6" md="4">
                <MudCard Elevation="25" Class="rounded-lg pb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5" Align="Align.Center">
                                @product.Title
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="d-flex justify-content-center">
                            <MudText Typo="Typo.h3">
                                @product.Price.ToString("C")
                            </MudText>
                        </div>
                        <MudList Class="mx-auto mt-4" Style="width: 300px">
                            <MudListItem Icon="@Icons.Material.Filled.Check">Transações ilimitadas</MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Check">Categorias ilimitadas</MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Check">Acesso completo</MudListItem>
                        </MudList>
                    </MudCardContent>
                    <MudCardActions></MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudContainer>