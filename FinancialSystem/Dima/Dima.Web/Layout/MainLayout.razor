@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="isDarkMode" Theme="Configuration.Theme" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        Dima
        <MudSpacer />
        <MudSwitch @bind-Value="@isDarkMode" />
    </MudAppBar>
    <MudMainContent>
        <MudContainer>
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code{
    private bool isDarkMode = true;
}